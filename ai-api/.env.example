# ============================================
# TutorMina AI API — Environment Variables
# ============================================

# Groq API Key (required) — Get free from https://console.groq.com/keys
# Powers text generation (summaries/insights/fact-check), image OCR (vision), and
# fallback transcription. Free tier is rate-limited, not billed.
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides if Groq deprecates/renames a model — see console.groq.com/docs/models.
# NOTE: these must be IDs your account can actually list; an invalid ID fails every AI call.
# GROQ_TEXT_MODEL=qwen/qwen3.8-27b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# GROQ_STT_MODEL=whisper-large-v3

# Local Supabase (for development)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=your_local_supabase_service_role_key_here

# AssemblyAI (primary speech-to-text) — https://www.assemblyai.com/app/account
# Handles long/large recordings that exceed Groq Whisper's upload limit. If unset, STT
# silently falls back to Groq Whisper.
ASSEMBLYAI_API_KEY=

# Deepgram (optional, for real-time WebSocket transcription during live sessions)
# Get from https://console.deepgram.com — free $200 credit
DEEPGRAM_API_KEY=

# Serper (optional, for web search fact-checking)
# Get from https://serper.dev — free tier available
SERPER_API_KEY=

# Daily.co (required for automated video room provisioning) — get from
# https://dashboard.daily.co/developers. Server-side only, never expose to the client.
# (DAILY_API_KEY is also accepted as an alias.)
DAILYCO_API_KEY=

# Cron secret (required for Supabase pg_cron -> POST /cron/tick, see
# 00030_booking_reminders_cron.sql). Must match private.app_config.cron_secret in the DB.
CRON_SECRET=

# Environment flag
ENVIRONMENT=development

# CORS Origins (comma-separated) — must include your production domain(s), e.g.
# https://tutormina.africa,https://www.tutormina.africa
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# TutorMina AI API — Environment Variables
# ============================================

# Groq API Key (required) — Get free from https://console.groq.com/keys
# Powers text generation (Llama 3.3 70B), transcription (Whisper large-v3), and
# image OCR (Qwen vision) — all open-source models, free tier is rate-limited not billed.
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides if Groq deprecates/renames a model — see console.groq.com/docs/models
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# GROQ_STT_MODEL=whisper-large-v3

# Local Supabase (for development)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=your_local_supabase_service_role_key_here

# Deepgram (optional, for real-time WebSocket transcription)
# Get from https://console.deepgram.com — free $200 credit
DEEPGRAM_API_KEY=

# Serper (optional, for web search fact-checking)
# Get from https://serper.dev — free tier available
SERPER_API_KEY=

# Environment flag
ENVIRONMENT=development

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

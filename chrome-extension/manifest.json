{
  "manifest_version": 3,
  "name": "TutorMina Chommie",
  "version": "0.1.0",
  "description": "Capture TutorMina tutoring/coaching sessions on Google Meet, Microsoft Teams, or Zoom and feed transcripts + fact-checks into your Learning Zone.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://*.hf.space/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TutorMina Chommie"
  }
}
